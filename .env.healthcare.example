# Healthcare demo defaults (safe for local only — not production secrets)
CHORUSCONTROL_DEMO_MODE=1
CHORUSCONTROL_ADMIN_TOKEN=healthcare-demo-token
CHORUSCONTROL_TRANSPORT_PRIMARY=http
CHORUSCONTROL_ALLOW_INSECURE_EXTERNAL=1
CHORUSCONTROL_LEDGER_SAMPLE_RATE=1.0
CHORUSCONTROL_METRICS_SAMPLE_INTERVAL=5
# Optional Postgres audit dual-write when using --profile postgres:
# DATABASE_URL=postgresql://cc:cc@postgres:5432/choruscontrol
